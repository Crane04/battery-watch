{
  "manifest_version": 3,
  "name": "Battery Watch",
  "version": "1.0.0",
  "description": "Live charge, cells and alerts for your JBD BMS battery over Bluetooth.",
  "permissions": ["notifications", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Battery Watch",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
